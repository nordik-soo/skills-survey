# Copy to .env and fill in real values.  Never commit the real .env.

# Postgres
POSTGRES_DB=sault_survey
POSTGRES_USER=sault
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
ADMINER_PORT=8080
API_PORT=3000

# Admin / data security
# ADMIN_PASSCODE gates the admin console + CSV export. Make it long & random:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSCODE=replace-with-a-long-random-passcode
# SESSION_SECRET signs login cookies. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
